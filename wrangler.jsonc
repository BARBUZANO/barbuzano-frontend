{
  "name": "barbuzano",
  "main": "src/index.js",

  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },

  "routes": [
    { "pattern": "*barbuzano.com/*", "zone_name": "barbuzano.com" },
    { "pattern": "*.barbuzano.com/*", "zone_name": "barbuzano.com" },
    { "pattern": "barbuzano.com", "zone_name": "barbuzano.com", "custom_domain": true }
  ],

  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "2b5e35774f254017b7eed955a8912001" }
  ],

  "r2_buckets": [
    { "binding": "BARBUZANO_FILES", "bucket_name": "barbuzano-files" }
  ]
}
